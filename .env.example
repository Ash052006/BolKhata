# Bolkhata — environment variable template
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# Default: SQLite (suitable for local development).
# PostgreSQL (requires pg Docker profile):
#   DATABASE_URL=postgresql+asyncpg://bolkhata:CHANGE_ME@localhost:5432/bolkhata  # pragma: allowlist secret
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:////data/bolkhata.db

# ---------------------------------------------------------------------------
# PostgreSQL (only needed when using the pg Docker Compose profile)
# ---------------------------------------------------------------------------
POSTGRES_USER=bolkhata
POSTGRES_PASSWORD=CHANGE_ME_before_use
POSTGRES_DB=bolkhata

# ---------------------------------------------------------------------------
# Voice & Model Providers (Stage 1: mock)
# Options:
#   ASR_PROVIDER: mock | faster_whisper | mlx_whisper
#   TTS_PROVIDER: mock | piper | edge
#   LLM_PROVIDER: mock | groq | ollama
#   VAD_PROVIDER: none | mock
# ---------------------------------------------------------------------------
ASR_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock
VAD_PROVIDER=none
