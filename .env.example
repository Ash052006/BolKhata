# Bolkhata — environment variable template
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# Default: SQLite (suitable for local development).
# PostgreSQL (requires pg Docker profile):
#   DATABASE_URL=postgresql+asyncpg://bolkhata:CHANGE_ME@localhost:5432/bolkhata
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:////data/bolkhata.db

# ---------------------------------------------------------------------------
# PostgreSQL (only needed when using the pg Docker Compose profile)
# ---------------------------------------------------------------------------
POSTGRES_USER=bolkhata
POSTGRES_PASSWORD=CHANGE_ME_before_use
POSTGRES_DB=bolkhata
